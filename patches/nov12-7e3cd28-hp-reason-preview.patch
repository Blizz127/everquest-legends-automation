+def gauge_label(name, value, reason=None):
+    """Keep an unreadable gauge unknown and tell the owner how to fix HP."""
+    if value is not None:
+        return f"{name} · {round(value * 100)}%"
+    if name == "HP":
+        if reason == "hp_recalibrate_inner_bar":
+            return "HP · recalibrate inner red bar (5–24px high)"
+        if isinstance(reason, str) and reason.startswith("size_mismatch:"):
+            return "HP · game window size changed; recalibrate"
+        if reason == "rejected":
+            return "HP · red fill not recognized; recalibrate"
+        if reason == "no_window":
+            return "HP · game window not found"
+    return f"{name} · no calibrated reading"
 
 
