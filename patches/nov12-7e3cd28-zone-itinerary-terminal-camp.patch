+def owner_terminal_itinerary_help():
+    """Describe the separate terminal-camp selection without opening assets."""
+    from eql_automation.owner_zone_itinerary_assets import OWNER_TERMINAL_ITINERARY_MAXIMUM_SECONDS
+    minutes = int((OWNER_TERMINAL_ITINERARY_MAXIMUM_SECONDS + 59) // 60)
+    hours, minutes = divmod(minutes, 60)
+    duration = f"{hours} hours {minutes} minutes" if hours else f"{minutes} minutes"
+    return ("Start near Goblin Camp in Butcherblock Mountains. Cross Greater Faydark and enter Clan Crushbone, "
+            "measure movement again, then travel to Slave Mines. After a fresh stopped arrival, the helper "
+            "prepares learned spells again and starts a stationary camp using observed NPC names and fresh target checks. "
+            "The configured level must be 1–19. Camping stops at observed level 20 or a failed check; it never travels "
+            "to another camp. "
+            f"Navigation is capped at {duration}, including measurements and crossings. This maximum is not a "
+            "travel-time estimate and does not include subsequent camping. "
+            "Actual routes, arrivals and camp suitability remain unverified; this is not verified 1–50 automation. "
+            "Stay present. F8 switches to assist after movement releases; F9/F11 stops travel or camping.")
+
+
+def owner_terminal_itinerary_selected(autopilot):
+    from eql_automation.owner_zone_itinerary_assets import OWNER_TERMINAL_ITINERARY_ID
+    trip = autopilot.get("zone_itinerary")
+    return isinstance(trip, dict) and trip.get("record_id") == OWNER_TERMINAL_ITINERARY_ID
+
+
+def terminal_itinerary_level_allowed(level):
+    return type(level) is int and 1 <= level < 20
 
 
