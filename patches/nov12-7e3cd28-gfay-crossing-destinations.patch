+def gfay_destination_help(identifier):
+    """Describe the packaged route's actual start and terminal behavior."""
+    from eql_automation.source_destinations import destination_spec
+    if identifier in ("butcher-gfay-preline-stop", "butcher-gfay-crossing"):
+        start = "Start near Goblin Camp inside Butcherblock Mountains, or resume near this route. "
+        destination = "The Greater Faydark"
+    elif identifier in ("gfay-orc-camps", "gfay-orc-camps-stop"):
+        start = "Start inside Greater Faydark near the Butcherblock entrance, or resume near this route to Orc Camps. "
+        destination = None
+    elif identifier in ("gfay-crushbone-preline-stop", "gfay-crushbone-crossing"):
+        start = "Start near Orc Camps inside Greater Faydark, or resume near this route. "
+        destination = "Clan Crushbone"
+    elif identifier in ("gfay-butcher-crushbone-preline-stop", "gfay-butcher-crushbone-crossing"):
+        start = "Start inside Greater Faydark near the Butcherblock entrance, or resume near this route toward Crushbone. "
+        destination = "Clan Crushbone"
+    else:
+        return None
+    mode = destination_spec(identifier).arrival_mode
+    if mode == "zone_crossing":
+        ending = ("Crosses into " + destination + ", then stops after two fresh location replies in the destination zone. "
+                  "It starts no camp and does not continue to another zone. ")
+    elif mode == "camp":
+        ending = ("Starts stationary camping only after a fresh stopped arrival at Orc Camps. "
+                  "Observed Greater Faydark NPC history and fresh target checks are required; no history means no camp travel. "
+                  "The copied map suggests levels 4–7. There is no supported onward camp from Orc Camps yet. ")
+    elif destination is None:
+        ending = "Stops at Orc Camps without combat. The copied map suggests levels 4–7. "
+    else:
+        ending = "Stops at the approach before the zone line, without crossing or combat. "
+    return (start + ending + "The route continues checked sections with fresh movement measurements at each stop. "
+            "A failed check stops travel; cancellation never restarts it. "
+            "Actual movement, server destination and camp suitability remain unverified. Stay present. F8 assist; F9/F11 stop.")
 
 
