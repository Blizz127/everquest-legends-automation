+        def configure_location_hotkey_test(self):
+            if not measurement_only:
+                return
+            from eql_automation.location_hotkey import HOTKEY_CODES
+            dialog = QDialog(self)
+            dialog.setWindowTitle("Test your /location hotbutton")
+            layout = QVBoxLayout(dialog)
+            text = QLabel("In EverQuest, create a hotbutton containing only /location. Bind it to a "
+                          "function key below and remove any other action on that key. Manually verify "
+                          "that it prints your position and does nothing else.\n\n"
+                          "This test sends that key once after a four-second focus countdown. "
+                          "Close chat, stand still and release keys. F9/F11 stop. It does not start a route.")
+            text.setWordWrap(True)
+            layout.addWidget(text)
+            key = QComboBox()
+            key.addItem("Choose the key you configured", None)
+            for name in HOTKEY_CODES:
+                key.addItem(name, name)
+            layout.addWidget(key)
+            confirmation = QCheckBox("I verified this key runs only /location in this game session.")
+            layout.addWidget(confirmation)
+            buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
+            ok = buttons.button(QDialogButtonBox.StandardButton.Ok)
+            ok.setText("Test once")
+            ok.setEnabled(False)
+            refresh = lambda *_: ok.setEnabled(key.currentData() is not None and confirmation.isChecked())
+            key.currentIndexChanged.connect(refresh)
+            confirmation.toggled.connect(refresh)
+            buttons.accepted.connect(dialog.accept)
+            buttons.rejected.connect(dialog.reject)
+            layout.addWidget(buttons)
+            if dialog.exec() == QDialog.DialogCode.Accepted:
+                self.post("test_location_hotkey", {"key_name": key.currentData(), "confirmed": True})
+
