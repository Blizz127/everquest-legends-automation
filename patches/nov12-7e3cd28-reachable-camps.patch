+    def camp_reachable(self, zone, loc, *, from_zone, from_loc=None) -> bool:
+        """Require a camp and its origin/entrance on the same dry component.
+
+        This is copied-mesh evidence only. Doors, trigger volumes and actual
+        movement still need a supervised client test before travel is enabled.
+        """
+        mesh = self._mesh(zone)
+        route = self.route(from_zone, zone)
+        if mesh is None or loc is None or route is None:
+            return False
+        snapped = self.snap(zone, loc)
+        if snapped is None:
+            return False
+        target = mesh.locate(self._in(snapped), radius=8.0)
+        if target is None:
+            return False
+        dry = dry_components(mesh)
+        component = int(dry[target[0]])
+        if component < 0:
+            return False
+        if from_zone == zone and from_loc is not None:
+            origin = mesh.locate(self._in(from_loc), radius=15.0)
+            return origin is not None and int(dry[origin[0]]) == component
+        if route:
+            if from_loc is None:
+                return False
+            start_mesh = self._mesh(from_zone)
+            if start_mesh is None:
+                return False
+            origin = start_mesh.locate(self._in(from_loc), radius=15.0)
+            if origin is None:
+                return False
+            start_component = int(dry_components(start_mesh)[origin[0]])
+            if start_component not in line_approaches(start_mesh, route[0]):
+                return False
+            for incoming, outgoing in zip(route, route[1:]):
+                middle_mesh = self._mesh(outgoing.zone)
+                if middle_mesh is None:
+                    return False
+                incoming_components = set()
+                for entry in self.store.zone_lines(outgoing.zone):
+                    if entry.to_zone == incoming.zone:
+                        incoming_components.update(line_approaches(middle_mesh, entry))
+                if not incoming_components.intersection(
+                        line_approaches(middle_mesh, outgoing)):
+                    return False
+            # Require dry ground beside a reciprocal entrance to this zone.
+            return any(
+                component in line_approaches(mesh, entry)
+                for entry in self.store.zone_lines(zone)
+                if entry.to_zone == route[-1].zone)
+        return component == travel_component(mesh, self.store.zone_lines(zone))
