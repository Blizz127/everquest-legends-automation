+def test_unreachable_primary_camp_falls_back_without_retaining_or_forcing_it(guide):
+    reachable = lambda camp: camp.id != "crushbone-trainer-hill"
+    camp, reason = guide.select_camp(9, zone="crushbone", eligible=reachable)
+    assert camp.id == "gfaydark-orc-camps", reason
+    previous = guide.camp("crushbone-trainer-hill")
+    camp, reason = guide.select_camp(9, zone="crushbone", current=previous,
+                                     eligible=reachable)
+    assert camp.id == "gfaydark-orc-camps", reason
+    camp, reason = guide.select_camp(9, zone="crushbone",
+                                     override="crushbone-trainer-hill", eligible=reachable)
+    assert camp is None and "no verified route" in reason
+    camp, reason = guide.select_camp(9, zone="crushbone", eligible=lambda camp: False)
+    assert camp is None and "no camp has a verified route" in reason
 
 
