+        def configure_supervised_crossing(self):
+            if not measurement_only:
+                return
+            dialog = QDialog(self)
+            dialog.setWindowTitle("Supervised travel into Crushbone")
+            layout = QVBoxLayout(dialog)
+            text = QLabel("This starts in Greater Faydark, follows a checked route into the expected Crushbone zone line, "
+                          "then stops after two fresh arrival positions. It does not fight, loot or level. "
+                          "Actual crossing is not yet verified.\n\n"
+                          "First open the map and use Test /location hotbutton in this helper to recognize your current zone. "
+                          "Close the map and chat, clear your target and turn melee off. Start on clear, flat, open ground. "
+                          "After a four-second focus countdown, seven short calibration presses precede the route.\n\n"
+                          "Stay present. F9/F11 or Stop measurement cancels. A failed check stops the action without restarting. "
+                          "Travel is limited to 25 minutes, followed by at most 90 seconds to observe arrival.")
+            text.setWordWrap(True)
+            layout.addWidget(text)
+            confirmation = QCheckBox("I will supervise; the starting calibration area is clear, flat and open.")
+            layout.addWidget(confirmation)
+            buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
+            ok = buttons.button(QDialogButtonBox.StandardButton.Ok)
+            ok.setText("Start travel into Crushbone")
+            ok.setEnabled(False)
+            confirmation.toggled.connect(ok.setEnabled)
+            buttons.accepted.connect(dialog.accept)
+            buttons.rejected.connect(dialog.reject)
+            layout.addWidget(buttons)
+            if dialog.exec() == QDialog.DialogCode.Accepted and confirmation.isChecked():
+                self.post("supervised_crushbone_crossing", {"open_flat_clear": True})
