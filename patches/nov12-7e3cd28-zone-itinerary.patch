+def owner_itinerary_help():
+    """Describe the separately selected whole trip without loading game assets."""
+    from eql_automation.owner_zone_itinerary_assets import OWNER_ITINERARY_MAXIMUM_SECONDS
+    minutes = int((OWNER_ITINERARY_MAXIMUM_SECONDS + 59) // 60)
+    hours, minutes = divmod(minutes, 60)
+    duration = f"{hours} hours {minutes} minutes" if hours else f"{minutes} minutes"
+    return ("Start near Goblin Camp in Butcherblock Mountains. Cross into Greater Faydark, "
+            "continue to Clan Crushbone, then stop without combat or a camp. "
+            "The helper checks the reached position and measures movement again in each new zone "
+            "and at intermediate route stops. An unsupported arrival or failed check stops the trip. "
+            f"The whole trip is capped at {duration}, including measurements and crossings. "
+            "This is a maximum limit, not a travel-time estimate. "
+            "Actual routes and server arrivals remain unverified. Stay present throughout. "
+            "F8 switches to assist after movement releases; F9/F11 stops.")
+
+
+def owner_itinerary_progress(autopilot):
+    """Render the current root stage, including the first leg's setup."""
+    trip = autopilot.get("zone_itinerary")
+    if not isinstance(trip, dict):
+        return (("Releasing movement" if autopilot.get("state") == "stopping" else "Finish in Clan Crushbone")
+                if autopilot.get("journey_phase") == "zone_itinerary" else None)
+    leg, legs = trip.get("leg"), trip.get("legs")
+    prefix = f"Leg {leg}/{legs} · " if (type(leg) is int and type(legs) is int and 1 <= leg <= legs <= 8) else ""
+    stage = {"walking": "Travel", "crossing": "Crossing", "loading": "Loading zone",
+             "arrival": "Checking arrival", "bootstrap": "Measuring destination", "stopping": "Releasing movement",
+             "complete": "Complete"}.get(
+        trip.get("stage"), "Travel")
+    return prefix + stage
 
 
