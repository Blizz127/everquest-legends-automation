+def owner_camp_progression_help():
+    """Explain the explicit early-camp progression without loading game assets."""
+    from eql_automation.owner_camp_progression_assets import CAMP_ORIGIN_MAXIMUM_SECONDS
+    minutes = int((CAMP_ORIGIN_MAXIMUM_SECONDS + 59) // 60)
+    hours, minutes = divmod(minutes, 60)
+    duration = f"{hours} hours {minutes} minutes" if hours else f"{minutes} minutes"
+    return ("Start near Newbie Hills in Butcherblock with configured level 1–4. Travel to Newbie Hills and camp. "
+            "A newly observed level 5 supports the move to Goblin Camp after recovery. A fresh level 9 or 10 "
+            "observed while camping at Goblin Camp can then start travel through Greater Faydark and Crushbone "
+            "to Slave Mines after recovery. Changing the configured level alone never starts these departures. "
+            "Each arrival prepares learned spells again and uses observed NPC names with fresh target checks. "
+            "New destination measurements and checked steps are required during travel. At Slave Mines, the "
+            "progression ends in stationary camping, which stops at observed level 20; there is no further relocation. "
+            f"Only navigation from Goblin Camp onward is capped at {duration}. This is not an ETA or a limit "
+            "for the whole progression: it excludes the initial Newbie Hills approach, the later travel to Goblin "
+            "Camp and all camping time. "
+            "The ordinary next-camp checkbox does not select or change this progression. "
+            "Real routes, camp suitability and level gains remain unverified; this is not verified 1–50 automation. "
+            "Stay present. F8 switches to assist after movement releases; F9/F11 stops.")
+
+
+def camp_progression_level_allowed(level):
+    return type(level) is int and 1 <= level <= 4
+
+
+def owner_camp_progression_progress(autopilot):
+    progression = autopilot.get("camp_progression")
+    if not isinstance(progression, dict):
+        return None
+    if autopilot.get("state") == "stopping" or progression.get("phase") in {"stopping", "cancelled", "stopped"}:
+        return "Releasing movement"
+    phase = progression.get("phase")
+    if phase in {"consumed", "terminal_camp"}:
+        return None
+    itinerary = owner_itinerary_progress(autopilot)
+    if itinerary is not None:
+        return "Goblin onward · " + itinerary
+    if phase == "newbie_camp" and (autopilot.get("journey_phase") in {"camp_section_handoff", "camp_walking_sections"}
+            or autopilot.get("journey_destination_id") == "goblin-camp"):
+        return "Travel to Goblin Camp"
+    return {"newbie_request": "Travel to Newbie Hills",
+            "newbie_camp": "Newbie Hills camp · observed level 5 departure after recovery",
+            "goblin_camp": "Goblin Camp · observed level 9 or 10 departure after recovery",
+            "origin_claimed": "Measuring departure from Goblin Camp",
+            "navigating": "Travel to Slave Mines"}.get(phase, "Early camp progression")
 
 
